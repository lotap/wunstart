VITE_COOKIE_DOMAIN="localhost"

DATABASE_URL="postgres://postgres:mypassword@localhost:5432/postgres"

ACCESS_TOKEN_SECRETS="key-id:random-secret,foo:bar,access:access"
ANON_TOKEN_SECRETS="key-id:random-secret,foo:bar,anon:anon"
REFRESH_TOKEN_SECRETS="key-id:random-secret,foo:bar,refresh:refresh"

REFRESH_GRACE_TOKEN_SECRETS="key-id:random-secret,foo:bar,grace:grace"

CLOUDFLARE_ENV="development"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=${DATABASE_URL}