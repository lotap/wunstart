{
	"name": "wunstart",
	"version": "0.0.0",
	"private": true,
	"description": "Build on primitives that you can read and your agent can extend. A starter that’s fast, opinionated, and promptable.",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"app-identity": "sh tools/pkg-scripts/run-ts.sh tools/setup/app-identity/main.ts",
		"archive-old-activities": "dotenv -e .env.local -e .env -- sh tools/pkg-scripts/run-ts.sh src/scripts/archive-old-activities.ts",
		"branch-env": "sh tools/pkg-scripts/run-ts.sh tools/setup/branch-env/main.ts",
		"build": "vite build",
		"build:preview": "vite build --mode development",
		"build:wasm": "sh tools/pkg-scripts/build-wasm.sh",
		"cf-typegen": "wrangler types",
		"clean:tmp": "rm -rf .tmp && mkdir -p .tmp",
		"db:check": "sh tools/pkg-scripts/drizzle-kit.sh check",
		"db:export": "sh tools/pkg-scripts/drizzle-kit.sh export",
		"db:generate": "sh tools/pkg-scripts/drizzle-kit.sh generate",
		"db:mcp": "sh tools/pkg-scripts/drizzle-kit.sh mcp",
		"db:migrate": "sh tools/pkg-scripts/drizzle-kit.sh migrate",
		"db:pull": "sh tools/pkg-scripts/drizzle-kit.sh pull",
		"db:push": "sh tools/pkg-scripts/drizzle-kit.sh push",
		"db:skills": "sh tools/pkg-scripts/drizzle-kit.sh skills",
		"db:studio": "sh tools/pkg-scripts/drizzle-kit.sh studio",
		"db:up": "sh tools/pkg-scripts/drizzle-kit.sh up",
		"deploy": "vite build && wrangler deploy",
		"dev": "dotenv -e .env.development -e .env.local --override -- vite dev",
		"dev:email": "email dev --dir src/email/templates --port 3001",
		"fmt": "oxfmt src/ tools/",
		"fmt:check": "oxfmt --check src/ tools/",
		"install-deps": "sh tools/pkg-scripts/run-ts.sh tools/setup/install-deps/main.ts",
		"lint": "oxlint src/ tools/",
		"lint:check": "oxlint --deny-warnings src/ tools/",
		"predev": "sh tools/pkg-scripts/install-deps.sh",
		"prepare": "sh tools/pkg-scripts/setup-git-hooks.sh && effect-tsgo patch",
		"preview": "dotenv -e .env.development -e .env.local --override -- vite preview --mode development",
		"setup:hooks": "sh tools/pkg-scripts/setup-git-hooks.sh",
		"test:lint": "vitest run --config tools/linters/vitest.config.ts",
		"validate-required-env": "sh tools/pkg-scripts/run-ts.sh tools/pkg-scripts/validate-required-env.ts",
		"validate-setup": "sh tools/pkg-scripts/run-ts.sh tools/pkg-scripts/validate-setup.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@cloudflare/vite-plugin": "^1.53.1",
		"@effect/sql-pg": "4.0.0-beta.102",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@paper-design/shaders-react": "^0.0.81",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "0.10.12",
		"@tanstack/react-form": "2.0.0-alpha.2",
		"@tanstack/react-query": "^5.104.4",
		"@tanstack/react-query-devtools": "^5.104.4",
		"@tanstack/react-router": "1.170.33",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.168.48",
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-en": "^4.1.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.2.5",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"effect": "4.0.0-beta.102",
		"input-otp": "^1.5.0",
		"jose": "^6.2.10",
		"lucide-react": "^1.35.0",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "^6.9.2",
		"shadcn": "^4.19.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"ua-parser-js": "^1.0.41"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260821.1",
		"@effect/tsgo": "0.36.5",
		"@oxlint/plugins": "^1.80.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/eslint-plugin-query": "^5.103.1",
		"@tanstack/react-form-devtools": "^1.0.0-alpha.2",
		"@tanstack/router-cli": "^1.167.32",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/ua-parser-js": "^0.7.39",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.1.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv-cli": "^11.0.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-hooks": "^7.1.1",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"oxlint-plugin-react-doctor": "^0.9.14",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	}
}
