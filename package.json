{
	"name": "wunstart",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"archive-old-activities": "dotenv -e .env.local -e .env -- bun --bun run src/scripts/archive-old-activities.ts",
		"build": "bun run build:wasm && vite build",
		"build:preview": "vite build --mode development",
		"build:wasm": "cd crates/argon2-do-hasher && cargo build --target wasm32-unknown-unknown --release && cp target/wasm32-unknown-unknown/release/argon2_do_hasher.wasm ../../src/durable-objects/argon2-do-hasher.wasm",
		"cf-typegen": "wrangler types",
		"db": "dotenv -e .env.development -- drizzle-kit",
		"db:check": "bun --bun run db -- check",
		"db:export": "bun --bun run db -- export",
		"db:generate": "bun --bun run db -- generate",
		"db:mcp": "bun --bun run db -- mcp",
		"db:migrate": "bun --bun run db -- migrate",
		"db:pull": "bun --bun run db -- pull",
		"db:push": "bun --bun run db -- push",
		"db:seed": "dotenv -e .env.local -- bun --bun run src/db/seed.ts",
		"db:skills": "bun --bun run db -- skills",
		"db:studio": "bun --bun run db -- studio",
		"db:up": "bun --bun run db -- up",
		"deploy": "bun run build && wrangler deploy",
		"dev": "vite dev --port 3000",
		"dev:email": "email dev --dir src/email/templates --port 3001",
		"fmt": "oxfmt src/",
		"fmt:check": "oxfmt --check src/",
		"generate-routes": "tsr generate",
		"lint": "oxlint src/",
		"lint:check": "oxlint --deny-warnings src/",
		"prepare": "effect-tsgo patch",
		"preview": "vite preview --mode development",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@cloudflare/vite-plugin": "^1.53.1",
		"@effect/sql-pg": "4.0.0-beta.102",
		"@fontsource-variable/inter": "^5.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-devtools": "0.10.12",
		"@tanstack/react-form": "2.0.0-alpha.2",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "1.170.31",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "1.168.48",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"effect": "4.0.0-beta.102",
		"input-otp": "^1.5.0",
		"jose": "^6.2.10",
		"lucide-react": "^1.35.0",
		"next-themes": "^0.4.6",
		"pg": "^8.23.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-email": "^6.9.2",
		"shadcn": "^4.19.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"ua-parser-js": "^1.0.41"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260821.1",
		"@effect/tsgo": "0.36.5",
		"@oxlint/plugins": "^1.80.0",
		"@react-email/ui": "^6.9.2",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/eslint-plugin-query": "^5.101.4",
		"@tanstack/react-form-devtools": "^1.0.0-alpha.2",
		"@tanstack/router-cli": "^1.167.32",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/ua-parser-js": "^0.7.39",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.1.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv-cli": "^11.0.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"jsdom": "^30.0.1",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"oxlint-plugin-react-doctor": "^0.9.12",
		"oxlint-tsgolint": "^7.0.2001",
		"tsx": "^4.23.12",
		"type-fest": "^5.7.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
