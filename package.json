{
	"name": "wunstart",
	"version": "0.0.0",
	"private": true,
	"description": "Build on primitives that you can read and your agent can extend. A starter that’s fast, opinionated, and promptable.",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	},
	"aube": {
		"allowBuilds": {
			"esbuild": true,
			"workerd": true
		}
	},
	"overrides": {
		"solid-js": "1.9.17"
	},
	"scripts": {
		"agent-dev": "sh tools/pkg-scripts/agent-dev.sh",
		"app-identity": "sh tools/pkg-scripts/run-ts.sh tools/setup/app-identity/main.ts",
		"archive-old-activities": "dotenv -e .env.local -e .env -- sh tools/pkg-scripts/run-ts.sh src/scripts/archive-old-activities.ts",
		"branch-env": "sh tools/pkg-scripts/run-ts.sh tools/setup/branch-env/main.ts",
		"build": "vite build",
		"build:preview": "vite build --mode development",
		"build:wasm": "sh tools/pkg-scripts/build-wasm.sh",
		"check": "sh tools/pkg-scripts/check.sh",
		"cf-typegen": "wrangler types",
		"clean:tmp": "rm -rf .tmp && mkdir -p .tmp",
		"db:check": "sh tools/pkg-scripts/drizzle-kit.sh check",
		"db:export": "sh tools/pkg-scripts/drizzle-kit.sh export",
		"db:generate": "sh tools/pkg-scripts/drizzle-kit.sh generate",
		"db:mcp": "sh tools/pkg-scripts/drizzle-kit.sh mcp",
		"db:migrate": "sh tools/pkg-scripts/drizzle-kit.sh migrate",
		"db:pull": "sh tools/pkg-scripts/drizzle-kit.sh pull",
		"db:push": "sh tools/pkg-scripts/drizzle-kit.sh push",
		"db:skills": "sh tools/pkg-scripts/drizzle-kit.sh skills",
		"db:studio": "sh tools/pkg-scripts/drizzle-kit.sh studio",
		"db:up": "sh tools/pkg-scripts/drizzle-kit.sh up",
		"deploy": "vite build && wrangler deploy",
		"dev": "dotenv -e .env.development -e .env.local --override -- vite dev",
		"dev:email": "email dev --dir src/email/templates --port 3001",
		"fmt": "oxfmt src/ tools/",
		"fmt:check": "oxfmt --check src/ tools/",
		"install-deps": "sh tools/pkg-scripts/run-ts.sh tools/setup/install-deps/main.ts",
		"lint": "oxlint src/ tools/",
		"lint:check": "oxlint --deny-warnings src/ tools/",
		"lint:tailwind": "sh tools/pkg-scripts/run-ts.sh tools/linters/tailwind/main.ts",
		"predev": "sh tools/pkg-scripts/install-deps.sh",
		"prepare": "sh tools/pkg-scripts/setup-git-hooks.sh && effect-tsgo patch --oxlint",
		"preview": "dotenv -e .env.development -e .env.local --override -- vite preview --mode development",
		"setup:hooks": "sh tools/pkg-scripts/setup-git-hooks.sh",
		"test:lint": "vitest run --config tools/linters/vitest.config.ts",
		"validate-required-env": "sh tools/pkg-scripts/run-ts.sh tools/pkg-scripts/validate-required-env.ts",
		"validate-setup": "sh tools/pkg-scripts/run-ts.sh tools/pkg-scripts/validate-setup.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@cloudflare/vite-plugin": "^1.69.1",
		"@effect/sql-pg": "4.1.4",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@icons-pack/react-simple-icons": "^13.15.1",
		"@paper-design/shaders-react": "^0.0.82",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-form": "2.0.0-alpha.2",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-query-devtools": "^5.107.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.3",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.5",
		"@zxcvbn-ts/core": "^4.3.0",
		"@zxcvbn-ts/language-common": "^4.2.0",
		"@zxcvbn-ts/language-en": "^4.1.2",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-kit": "1.0.0-rc.5",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "4.1.4",
		"input-otp": "^1.5.0",
		"jose": "^6.2.17",
		"lucide-react": "^1.73.0",
		"pele": "^1.13.0",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-email": "^6.11.13",
		"shadcn": "^4.23.0",
		"shiki": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"ua-parser-js": "^1.0.41"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261115.1",
		"@effect/tsgo": "0.69.0",
		"@oxlint/plugins": "^1.93.0",
		"@react-email/ui": "6.11.13",
		"@rolldown/plugin-babel": "^0.3.1",
		"@tailwindcss/language-server": "0.16.0",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/eslint-plugin-query": "^5.107.1",
		"@tanstack/react-form-devtools": "^1.0.0-alpha.3",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/ua-parser-js": "^0.7.39",
		"@vitejs/plugin-react": "^6.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv-cli": "^11.1.0",
		"eslint-plugin-drizzle": "^0.2.3",
		"eslint-plugin-react-hooks": "^7.1.1",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-plugin-react-doctor": "^0.9.23",
		"oxlint-tsgolint": "^7.0.2007",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vite-imagetools": "^12.0.2",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	}
}
